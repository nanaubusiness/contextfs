{
  "name": "contextfs",
  "version": "1.0.0",
  "description": "Transform a codebase into a structured, queryable context system for AI coding tools",
  "type": "module",
  "bin": {
    "contextfs": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepublish": "npm run build",
    "test": "npx tsx test/llm-only-test.ts",
    "test:llm": "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY npx tsx test/llm-token-test.ts",
    "test:2000": "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY npx tsx test/quality-2000.ts",
    "test:vitest": "vitest run"
  },
  "keywords": [
    "ai",
    "codebase",
    "context",
    "summaries",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pkg": "^5.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
